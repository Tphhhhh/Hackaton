    "pretest": "npm run validators",
    "prepare:live": "node scripts/prepare-live.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@mediapipe/tasks-vision": "1.1.0",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "vite": "^8.3.4"
  }
}
