# Copier en .env (jamais commité) pour activer Bedrock. Sans ces variables,
# le pipeline tourne en local (similarité n-grammes, explication par gabarit).
USE_BEDROCK=0
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
