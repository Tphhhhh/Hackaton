# Région imposée par le hackathon : us-east-1 uniquement. Modèles autorisés : voir le guide AWS.
# Copier en .env (jamais commité) pour activer Bedrock. Sans ces variables,
# le pipeline tourne en local (similarité n-grammes, explication par gabarit).
USE_BEDROCK=0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
